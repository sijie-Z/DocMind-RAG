{
  "name": "docmind-frontend",
  "version": "1.0.0",
  "description": "DocMind 企业级 RAG 知识库前端 - Vue 3 + TypeScript + Naive UI",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "api:generate": "openapi --input http://localhost:8000/openapi.json --output src/api/generated --client axios"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.2",
    "@vicons/ionicons5": "^0.13.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vueuse/core": "^10.7.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.15",
    "echarts": "^5.6.0",
    "highlight.js": "^11.12.0",
    "js-cookie": "^3.0.8",
    "katex": "^0.18.7",
    "lodash-es": "^4.17.21",
    "markdown-it": "^14.1.1",
    "markdown-it-highlightjs": "^4.3.0",
    "markdown-it-katex": "^2.0.3",
    "naive-ui": "^2.45.3",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.2",
    "qrcode": "^1.5.3",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "overrides": {
    "markdown-it-katex": {
      "katex": "0.16.28"
    }
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/highlight.js": "^9.12.4",
    "@types/js-cookie": "^3.0.6",
    "@types/katex": "^0.16.8",
    "@types/lodash-es": "^4.17.12",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.10.5",
    "@types/nprogress": "^0.2.3",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.11.0",
    "happy-dom": "^20.14.3",
    "jsdom": "^30.0.1",
    "openapi-typescript-codegen": "^0.31.0",
    "terser": "^5.51.2",
    "typescript": "^5.3.3",
    "unocss": "^66.10.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.5",
    "vue-eslint-parser": "^10.3.0",
    "vue-tsc": "^3.3.11",
    "vue-virtual-scroller": "^3.0.5"
  }
}
