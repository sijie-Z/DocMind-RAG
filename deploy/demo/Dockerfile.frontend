# DocMind Demo 前端镜像：构建 SPA 并以 nginx.demo.conf 提供服务。
# 构建（仓库根目录）：docker build -f deploy/demo/Dockerfile.frontend -t docmind-demo-frontend:latest .
FROM node:22-alpine AS builder

WORKDIR /build

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ .
# 演示构建参数（可选）：登录页「体验账号」一键登录由构建时注入，未传则隐藏。
# 仅用于演示部署，账号口令会进入前端产物——只放低权限演示账号，且保持 Access 门。
ARG VITE_DEMO_MODE=""
ARG VITE_DEMO_ACCOUNTS=""
RUN VITE_DEMO_MODE="$VITE_DEMO_MODE" VITE_DEMO_ACCOUNTS="$VITE_DEMO_ACCOUNTS" npm run build

# ---- Runtime ----
FROM nginx:1.25-alpine

COPY --from=builder /build/dist /usr/share/nginx/html
COPY deploy/demo/nginx.demo.conf /etc/nginx/conf.d/default.conf
COPY deploy/demo/security_headers.conf /etc/nginx/snippets/security_headers.conf

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:80/healthz || exit 1

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
