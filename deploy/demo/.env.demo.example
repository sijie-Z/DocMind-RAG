# DocMind Demo 部署环境（用于 sterlingzeng.cn 子域名的公开演示）
# 用法：cp deploy/demo/.env.demo.example backend/.env.docker
#      然后逐项填入真实值；NEVER commit backend/.env.docker。
# 说明：本文件同时被 docker compose 用作插值来源（--env-file）和
#      backend/worker/migrate 的 env_file，所以放在 backend/.env.docker 位置。

# --- Security (REQUIRED) ---
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# --- AI Models (REQUIRED) ---
# Chat：DeepSeek（OpenAI 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Embedding：Demo 推荐云端 API（省 1–2GB 内存，避免在演示机跑 Ollama）。
# 阿里云百炼（OpenAI 兼容）示例；如用 SiliconFlow，把三键换成 bge-m3 / 1024。
# URL / 模型 / 维度三键必须配套；索引新建时以 VECTOR_DIMENSION 为准。
EMBEDDING_API_KEY=
EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
VECTOR_DIMENSION=1024

# --- Database ---
# python -c "import secrets; print(secrets.token_hex(24))"
MYSQL_ROOT_PASSWORD=
# Demo 用独立库名：ES 索引按库名派生为 docmind_knowledge_demo，与主库/RC 隔离
MYSQL_DATABASE=docmind_demo
MYSQL_USER=docmind
MYSQL_PASSWORD=

# --- Elasticsearch ---
# 留空 = 按 DATABASE_URL 库名派生（docmind_demo → docmind_knowledge_demo）
ELASTICSEARCH_INDEX_NAME=

# --- Redis ---
REDIS_PASSWORD=

# --- MinIO ---
# MINIO_SECRET_KEY 至少 8 位
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=docmind-demo

# --- Application ---
DEBUG=false
LOG_LEVEL=INFO
DOCMIND_BIND_HOST=127.0.0.1
EXPOSE_EXCEPTION_DETAIL=false
AI_MAX_TOKENS=4000
AI_STREAM_TIMEOUT=120
# 演示站安全闸：单文件 10MB、普通 API 300 请求/分钟、聊天单独 30 请求/分钟
# （nginx 侧同名两档限流；后端 RATE_LIMIT 是最后一道兜底）
MAX_FILE_SIZE=10485760
RATE_LIMIT_REQUESTS_PER_MINUTE=300
# 演示账号（seed_demo.py 注册/登录用；ensure_demo_user 的 guest 保持关闭）
ENABLE_DEMO_ACCOUNT=false
ENABLE_ENSURE_DEMO_ENDPOINT=false
DEMO_PASSWORD=
# 冻结高风险能力（产品档只保留 文档入库 / 证据问答 / 核验工作台）
COMMANDS_ENABLED=false
ENABLE_WORKFLOW_CODE_NODES=false
SANDBOX_MODE=ast
LANGFUSE_ENABLED=false
ENABLE_TRACING=false

# --- Monitoring ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=
METRICS_LIVE_PERSIST_SECONDS=5

# --- Cloudflare Tunnel（仅 tunnel 模式需要）---
# 在 Cloudflare Zero Trust → Networks → Tunnels 创建，public hostname 指向
# http://frontend:80；把隧道 token 填到这里，再用 --profile tunnel 启动。
TUNNEL_TOKEN=
