# DocMind Docker Deployment - Environment Configuration
# Copy this file to .env.docker and fill in your values
# NEVER commit .env.docker to version control

# --- Security (REQUIRED) ---
# SECRET_KEY / JWT_SECRET_KEY 必须生成并填入，留空将导致服务启动失败
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# --- AI Models (REQUIRED) ---
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://open.bigmodel.cn/api/paas/v4/
DEEPSEEK_MODEL=glm-4-flash

EMBEDDING_API_KEY=
EMBEDDING_API_URL=https://open.bigmodel.cn/api/paas/v4/
EMBEDDING_MODEL=embedding-3
VECTOR_DIMENSION=2048

RERANK_API_KEY=
RERANK_API_URL=https://open.bigmodel.cn/api/paas/v4/
RERANK_MODEL=rerank

# --- Database ---
# 必填：生成强密码并填入（python -c "import secrets; print(secrets.token_hex(24))"），勿使用默认弱口令
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=docmind
MYSQL_USER=docmind
MYSQL_PASSWORD=

# --- Redis ---
# 建议设置强密码；留空时 Redis 以无密码模式运行（compose 中仅绑定 127.0.0.1）
REDIS_PASSWORD=

# --- MinIO ---
# 必填：生成随机凭据并填入（MINIO_SECRET_KEY 至少 8 位）
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=docmind

# --- Application ---
DEBUG=false
LOG_LEVEL=INFO
ENABLE_DEMO_ACCOUNT=true
ENABLE_ENSURE_DEMO_ENDPOINT=false
EXPOSE_EXCEPTION_DETAIL=false
AI_MAX_TOKENS=10000
AI_STREAM_TIMEOUT=120

# --- Monitoring ---
GRAFANA_USER=admin
# 必填：生成强密码并填入
GRAFANA_PASSWORD=
METRICS_LIVE_PERSIST_SECONDS=5

# --- Workflow safety ---
ENABLE_WORKFLOW_CODE_NODES=false
SANDBOX_MODE=auto

# --- Observability (Langfuse) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
