# DocMind Docker Deployment - Environment Configuration
# Copy this file to .env.docker and fill in your values
# NEVER commit .env.docker to version control

# --- Security (REQUIRED) ---
# SECRET_KEY / JWT_SECRET_KEY 必须生成并填入，留空将导致服务启动失败
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# --- AI Models (REQUIRED) ---
# 模型/向量维度默认值以代码真源为准：backend/app/core/config/ai.py
# Chat：DeepSeek（OpenAI 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Embedding：默认本机 Ollama 的 nomic-embed-text（768 维）。
# 容器内访问宿主机 Ollama 用 host.docker.internal；Linux 需给服务加
# extra_hosts: ["host.docker.internal:host-gateway"]，或直接填可访问的地址。
# 留空 EMBEDDING_API_KEY 时复用 DEEPSEEK_API_KEY（Ollama 不校验 Key）。
# 改用云端 Embedding 时 URL / 模型 / 维度三键必须配套。
EMBEDDING_API_KEY=
EMBEDDING_API_URL=http://host.docker.internal:11434/v1
EMBEDDING_MODEL=nomic-embed-text
VECTOR_DIMENSION=768

# Rerank：默认本地 BGE（RERANK_USE_LOCAL=true），无需 API 凭据。
# 如需云端 Rerank，取消注释并配套设置 RERANK_USE_LOCAL=false。
# RERANK_USE_LOCAL=false
# RERANK_API_KEY=
# RERANK_API_URL=
# RERANK_MODEL=rerank

# LLM 不可达快速失败（issue #467）：连接阶段独立短超时（秒）；读阶段沿用各调用
# 预算。连接被拒/DNS 失败在 1s 量级快速降级，读/写慢与连接建立后的瞬时中断
# 仍按可恢复故障处理（有限重试）。
# LLM_CONNECT_TIMEOUT_SECONDS=1.0
# LLM_TRANSIENT_MAX_RETRIES=1
# LLM_TRANSIENT_RETRY_BACKOFF_SECONDS=0.4
# LLM_UNREACHABLE_COOLDOWN_SECONDS=5.0

# --- Database ---
# 必填：生成强密码并填入（python -c "import secrets; print(secrets.token_hex(24))"），勿使用默认弱口令
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=docmind
MYSQL_USER=docmind
MYSQL_PASSWORD=

# --- Elasticsearch ---
# 索引名与 backend/.env.example 保持一致（代码默认值仅为兼容旧数据保留）
ELASTICSEARCH_INDEX_NAME=docmind_knowledge

# --- Redis ---
# 建议设置强密码；留空时 Redis 以无密码模式运行（compose 中仅绑定 127.0.0.1）
REDIS_PASSWORD=

# --- MinIO ---
# 必填：生成随机凭据并填入（MINIO_SECRET_KEY 至少 8 位）
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=docmind

# --- Application ---
DEBUG=false
LOG_LEVEL=INFO
# 演示账号默认关闭；仅在显式置 true 时由启动流程创建 guest（密码随机生成，无默认弱口令）
ENABLE_DEMO_ACCOUNT=false
ENABLE_ENSURE_DEMO_ENDPOINT=false
EXPOSE_EXCEPTION_DETAIL=false
AI_MAX_TOKENS=10000
AI_STREAM_TIMEOUT=120

# --- Monitoring ---
GRAFANA_USER=admin
# 必填：生成强密码并填入（compose 插值时缺失会直接报错）
GRAFANA_PASSWORD=
METRICS_LIVE_PERSIST_SECONDS=5

# --- Alerting（可选；与 deploy/monitoring 的 ALERT_WEBHOOK_TOKEN 保持一致）---
# ALERT_WEBHOOK_TOKEN=

# --- Workflow safety ---
ENABLE_WORKFLOW_CODE_NODES=false
# auto/docker require a reachable Docker daemon; without it code execution fails
# closed (issue #206). "ast" explicitly selects the in-process AST sandbox.
SANDBOX_MODE=auto

# --- Observability (Langfuse) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Prometheus 指标（issue #207）---
# 打开 app/core/prometheus.py 的 31 个指标（默认 no-op）。单进程部署安全；
# 多 worker 场景请先确认 prometheus_client multiprocess 配置（当前部署均为单进程）。
PROMETHEUS_ENABLED=true

# --- OpenTelemetry 链路追踪（可选；代码已接线 app/main.py，未配置则关闭）---
ENABLE_TRACING=false
# OTLP_ENDPOINT=http://otel-collector:4317

# --- 飞书工具凭据（可选）---
# 不配置则飞书相关工具不可用（工具默认对 LLM 可见，凭据缺失时调用会失败）
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
