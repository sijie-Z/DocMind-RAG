# ============================================================
# DocMind RAG 知识库系统 - 环境配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# --- 安全 (必填，否则服务无法启动) ---
# SECRET_KEY / JWT_SECRET_KEY 必须自行生成并填入，留空将导致服务启动失败
# 生成命令: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- AI 模型 (必填) ---
# 模型/向量维度默认值以代码真源为准：backend/app/core/config/ai.py
# Chat 模型 (DeepSeek / OpenAI 兼容)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AI_MAX_TOKENS=10000

# Embedding 模型（默认：本机 Ollama 的 nomic-embed-text，768 维）
# 留空 EMBEDDING_API_KEY 时复用 DEEPSEEK_API_KEY（本机 Ollama 不校验 Key）。
# 改用云端 Embedding 时 URL / 模型 / 维度三键必须配套，例如：
#   EMBEDDING_API_URL=https://api.openai.com/v1
#   EMBEDDING_MODEL=text-embedding-3-small
#   VECTOR_DIMENSION=1536
EMBEDDING_API_KEY=
EMBEDDING_API_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
VECTOR_DIMENSION=768
# 一致性校验（issue #196）：启动时真实调用一次 embedding，返回维度必须等于
# VECTOR_DIMENSION，否则拒绝启动；服务不可达只告警。EMBEDDING_SEND_DIMENSIONS
# 默认关闭——服务端截断会掩盖「维度配置已过期」的漂移，确认 provider 支持且
# 确实需要截断时才开启。
# EMBEDDING_STARTUP_PROBE=true
# EMBEDDING_PROBE_TIMEOUT_SECONDS=5
# EMBEDDING_SEND_DIMENSIONS=false

# Reranker (可选)
# 默认使用本地 cross-encoder（RERANK_USE_LOCAL=true），无需 API 凭据；
# 改用云端 rerank 时置 false，并配置 RERANK_API_KEY / RERANK_API_URL / RERANK_MODEL。
RERANK_USE_LOCAL=true
# RERANK_MODEL=rerank
# RERANK_API_KEY=sk-your-rerank-key
# RERANK_API_URL=https://api.deepseek.com
# RAG_ENABLE_RERANKER=true
#
# 检索不合格 → 拒答闸门 (issue #209，默认关闭)。
# 取重排后 top1 绝对分与阈值比较；低于阈值时：严格模式直接拒答（零 LLM 调用），
# 非严格模式清空检索上下文、按「知识库暂无相关文档」通用分支作答。
# 阈值必须用 evals 金标集按**实际启用的 reranker** 校准——不同 reranker 的分数
# 口径不同（本地 CE 为原始 logit，智谱 relevance_score 为 0–1，LLM 兜底为 0–10），
# 同一个数值阈值不可跨重排器复用。
# RAG_RELEVANCE_GATE_THRESHOLD=0.5

# --- RAG 检索与缓存 (可选) ---
# 语义缓存命中阈值 / 语义缓存条目 TTL(秒) / LLM 改写等待超时(秒)。
# issue #259:此前 Settings 缺字段、.env 里配了会被静默忽略,现三键均可覆盖.
# issue #195:语义缓存默认关闭——0.92 阈值会把相邻条款(第七条/第十三条)或
# 换实体的查询当成同一问题,跨问题返回他人 sources / 完整答案。显式开启后,
# 命中仍要求条号/数字/实体等价;检索精确缓存(RAG_ENABLE_CACHE)不受影响.
# SEMANTIC_CACHE_THRESHOLD=0.92
# SEMANTIC_CACHE_TTL_SECONDS=3600
# SEMANTIC_CACHE_RETRIEVAL_ENABLED=false
# SEMANTIC_CACHE_ANSWER_ENABLED=false
# RAG_QUERY_REWRITE_TIMEOUT_SECONDS=1.2

# --- LLM 连接级快速失败 (issue #467) ---
# 查询改写 / 查询分解 / HyDE / 重排 LLM 兜底 / 流式生成共用：连接阶段独立短超时(秒)。
# 端点不可达（连接被拒 / DNS 失败 / 连接阶段超时）时立即降级，不再等满读超时。
# 读/写阶段超时与连接建立后的瞬时中断属可恢复故障，不在此快速失败（保留有限重试）。
# 默认 1.0s 低于查询改写 1.2s 外层预算，是「<3s 暴露不可达」的结构前提；
# 高延迟链路可上调（如 2~3s），但会同比抬高不可达暴露时间。
# LLM_CONNECT_TIMEOUT_SECONDS=1.0
# 瞬时故障(408/409/429/5xx、连接建立后的传输中断)的重试次数；
# 连接类不可达与读超时零重试。
# LLM_TRANSIENT_MAX_RETRIES=1
# LLM_TRANSIENT_RETRY_BACKOFF_SECONDS=0.4
# 判定不可达后的进程级负缓存(秒)，按 LLM 端点(base_url)区分：
# 窗口内同一端点的改写/重排/生成直接快速失败，任一调用成功即清除；0 = 关闭。
# LLM_UNREACHABLE_COOLDOWN_SECONDS=5.0

# --- 基础设施 (Docker 默认值) ---
# 数据库凭据通过变量引用，避免在示例文件中写死明文 root:root
DB_USER=docmind
DB_PASSWORD=
DATABASE_URL=mysql+aiomysql://${DB_USER}:${DB_PASSWORD}@localhost:3306/docmind_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

ELASTICSEARCH_HOSTS=["http://localhost:9200"]
ELASTICSEARCH_INDEX_NAME=docmind_knowledge

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_FILE_PROCESSING_TOPIC=file-processing

MINIO_ENDPOINT=localhost:9000
# MinIO 凭据必须与服务端一致（留空则无法连接；compose 部署在 .env.docker 中设置，
# 并以 docker compose --env-file .env.docker 运行——Compose 插值读取该文件）
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=docmind
MINIO_SECURE=false

# --- 应用 ---
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false
# LLM 调用级 JSONL（issue #510）：每次 LLM 调用一行元数据（task_id/request_id/
# model/tokens/latency/prompt_hash），**不含 prompt/completion 正文**。默认开启。
LLM_CALL_LOG_ENABLED=true
LLM_CALL_LOG_FILE=logs/llm_calls.jsonl
# true=按 run 分文件（llm_calls-<task_id>.jsonl）；false=单文件追加
LLM_CALL_LOG_PER_RUN=false
# 演示账号默认关闭；仅在显式置 true 时由启动流程创建 guest（密码随机生成，无默认弱口令）
ENABLE_DEMO_ACCOUNT=false
# 演示账号 guest 的初始密码（仅 ENABLE_DEMO_ACCOUNT=true 时生效；留空则随机生成）。
# 注意：该键由进程直接读 os.environ，宿主直跑需导出为真实环境变量（.env 不注入 os.environ）。
# DEMO_PASSWORD=
EXPOSE_EXCEPTION_DETAIL=false
ENABLE_ENSURE_DEMO_ENDPOINT=false

# --- 文件上传 ---
MAX_FILE_SIZE=104857600
USER_STORAGE_LIMIT_BYTES=10737418240

# --- 监控告警 ---
ENABLE_MONITORING=true
MONITORING_INTERVAL=60
METRICS_LIVE_PERSIST_SECONDS=5
SLOW_REQUEST_THRESHOLD_MS=1200
ALERT_ERROR_RATE_PERCENT=5.0
ALERT_P95_MS=1200.0
ALERT_ACTIVE_CONNECTIONS=200
# ALERT_WEBHOOK_TOKEN=your-webhook-token

# --- 定时任务调度器（进程内 asyncio 循环；单实例语义，多 worker 部署需外部调度）---
ENABLE_SCHEDULER=true
SCHEDULER_POLL_SECONDS=30
SCHEDULER_DEFAULT_TIMEZONE=UTC

# --- 限流 ---
ENABLE_RATE_LIMIT=true
RATE_LIMIT_REQUESTS_PER_MINUTE=10000
RATE_LIMIT_WINDOW_SECONDS=60

# --- Webhook 入站运行（issue #478 / #497）---
# 默认关闭：管理 API 返回 503 WEBHOOKS_DISABLED，公共投递端点 404（不泄露规则
# 是否存在）。开启需同时配置 WEBHOOK_ENCRYPTION_KEY（独立 Fernet key，绝不能
# 复用 JWT SECRET_KEY）；启用但 key 缺失/非法时启动 fail-closed（进程退出，
# 错误信息含字段路径）。生成 key：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WEBHOOKS_ENABLED=false
WEBHOOK_ENCRYPTION_KEY=
# session_mode=reuse 命中会话后加载最近 N 条历史（agent 聊天同格式）。
WEBHOOK_REUSE_HISTORY_LIMIT=20

# --- 隐私 ---
ENABLE_PII_MASKING=true

# --- 安全执行 ---
# 工作流代码节点默认关闭，开启后必须通过 Docker 沙箱执行
ENABLE_WORKFLOW_CODE_NODES=false
# User Commands（issue #475）：服务端命令通道。false = 回滚到"斜杠文本按普通
# 提示词处理"的旧行为（GET /commands 返回 enabled=false，POST 拒绝执行）。
COMMANDS_ENABLED=true
# 代码执行沙箱：auto（Docker 可用则容器执行，否则拒绝）/ docker（仅容器）/
# ast（显式选择进程内 AST 沙箱）。auto/docker 在 Docker 不可用时 fail-closed，
# 不会静默回落进程内执行。见 issue #206。
SANDBOX_MODE=auto

# --- 可观测性 (Langfuse) ---
# 注册: https://cloud.langfuse.com 或自托管
# Deprecated candidate（issue #510 第三步待批准删除；未获批前保留）
LANGFUSE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxx
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Prometheus 指标（issue #207）---
PROMETHEUS_ENABLED=true

# --- OpenTelemetry 链路追踪（可选；代码已接线 app/main.py，未配置则关闭）---
# 注意：这两个键由 os.getenv 直读——宿主直跑需导出为真实环境变量（.env 不会注入
# os.environ）；容器部署由 env_file 生效。
ENABLE_TRACING=false
# OTLP_ENDPOINT=http://localhost:4317

# --- 飞书工具凭据（可选）---
# 不配置则飞书相关工具不可用（工具默认对 LLM 可见，凭据缺失时调用会失败）；
# 同系 os.getenv 直读，宿主直跑需导出为真实环境变量。
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=

# --- 独立 Agent 测试服务 app/agent_api.py（dev-only，可选）---
# 独立于主应用的小型 FastAPI（端口 8010），用于 Agent 离线评估/轨迹调试
# （/chat /trace /plan /eval），不随生产部署。该服务经 os.environ 直读配置、
# **不加载 .env**（宿主直跑需导出为真实环境变量）；DEEPSEEK_API_KEY /
# DEEPSEEK_API_URL 缺失会直接退出。启动：uvicorn app.agent_api:app --port 8010
# AGENT_API_KEY=          # 不配置则所有业务端点 503 拒绝（fail-closed）
# AGENT_API_MODEL=deepseek-v4-flash
# AGENT_DEMO_ORG_ID=      # 必填：显式正整数组织 ID；未配置/非法时业务请求 503（不回落 0）
# AGENT_DEMO_USER_ID=0
